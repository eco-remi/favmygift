{% extends 'base.html.twig' %}

{% block title %}{{ friend.email }}'s Wishlist{% endblock %}

{% block body %}
    <div class="flex justify-between mb-4">
        <h1>{{ friend.email }}'s Wishlist</h1>
        <a href="{{ path('app_friend_index') }}" class="btn btn-outline">{{ 'friend.show.back'|trans }}</a>
    </div>

    {% if gifts is empty %}
        <div class="card" style="text-align: center; padding: 4rem;">
            <p class="text-muted">{{ 'friend.show.empty'|trans }}</p>
        </div>
    {% else %}
        <div class="grid">
            {% for gift in gifts %}
                <div class="card">
                    {% if gift.imageUrl %}
                        <img src="{{ gift.imageUrl }}" alt="{{ gift.name }}" class="gift-image">
                    {% else %}
                        <div class="gift-image" style="display:flex;align-items:center;justify-content:center;color:var(--text-muted);">No Image</div>
                    {% endif %}
                    
                    <div class="flex justify-between" style="align-items: flex-start; margin-bottom: 0.5rem;">
                        <h3 style="margin: 0;">{{ gift.name }}</h3>
                        {% if app.user in gift.favoritedBy %}
                            <span style="font-size: 1.5rem; line-height: 1;">★</span>
                        {% endif %}
                    </div>
                    
                    <p class="text-muted">{{ gift.description }}</p>
                    
                    <div class="flex justify-between mt-4">
                        {% if gift.url %}
                            <a href="{{ gift.url }}" target="_blank" class="btn btn-outline" style="font-size: 0.8rem;">{{ 'common.view_link'|trans }}</a>
                        {% else %}
                            <span></span>
                        {% endif %}
                        
                        <form method="post" action="{{ path('app_gift_favorite', {'id': gift.id}) }}">
                            {% if app.user in gift.favoritedBy %}
                                <button class="btn btn-outline" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; border-color: gold; color: gold;">{{ 'friend.show.unstar'|trans }}</button>
                            {% else %}
                                <button class="btn btn-outline" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;">{{ 'friend.show.star'|trans }}</button>
                            {% endif %}
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
