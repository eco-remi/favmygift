{% extends 'base.html.twig' %}

{% block title %}Admin - {{ user.email }} Gifts{% endblock %}

{% block body %}
    <div class="flex justify-between mb-4">
        <h1>Gifts of {{ user.email }}</h1>
        <a href="{{ path('app_admin_index') }}" class="btn btn-outline">{{ 'friend.show.back'|trans }}</a>
    </div>

    {% if gifts is empty %}
        <div class="card" style="text-align: center; padding: 4rem;">
            <p class="text-muted">{{ 'friend.show.empty'|trans }}</p>
        </div>
    {% else %}
        <div class="grid">
            {% for gift in gifts %}
                <div class="card">
                    {% if gift.imageUrl %}
                        <img src="{{ gift.imageUrl }}" alt="{{ gift.name }}" class="gift-image">
                    {% endif %}
                    
                    <h3>{{ gift.name }}</h3>
                    <p class="text-muted">{{ gift.description }}</p>
                    <p class="text-muted" style="font-size: 0.8rem; margin-top: 0.5rem;">{{ gift.url }}</p>
                    
                    <div class="flex justify-between mt-4">
                        <form method="post" action="{{ path('app_admin_gift_delete', {'id': gift.id}) }}" onsubmit="return confirm('{{ 'common.delete_confirm'|trans }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ gift.id) }}">
                            <button class="btn btn-danger" style="width: 100%;">{{ 'common.delete'|trans }}</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
