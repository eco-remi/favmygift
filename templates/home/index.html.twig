{% extends 'base.html.twig' %}

{% block title %}Welcome to GiftList{% endblock %}

{% block body %}
<div style="text-align: center; margin-top: 4rem;">
    <h1 style="font-size: 3rem; margin-bottom: 1rem;">{{ 'home.subtitle'|trans }}</h1>
    <p class="text-muted" style="font-size: 1.25rem; max-width: 600px; margin: 0 auto 2rem;">
        {{ 'home.description'|trans }}
    </p>
    
    <div class="flex" style="justify-content: center; gap: 1rem;">
        <a href="{{ path('app_register') }}" class="btn btn-primary" style="font-size: 1.2rem; padding: 0.75rem 2rem;">{{ 'home.get_started'|trans }}</a>
        <a href="{{ path('app_login') }}" class="btn btn-outline" style="font-size: 1.2rem; padding: 0.75rem 2rem;">{{ 'nav.login'|trans }}</a>
    </div>
    
    <div class="grid" style="margin-top: 4rem; text-align: left;">
        <div class="card">
            <h3>{{ 'home.features.lists.title'|trans }}</h3>
            <p class="text-muted">{{ 'home.features.lists.desc'|trans }}</p>
        </div>
        <div class="card">
            <h3>{{ 'home.features.share.title'|trans }}</h3>
            <p class="text-muted">{{ 'home.features.share.desc'|trans }}</p>
        </div>
        <div class="card">
            <h3>{{ 'home.features.favorites.title'|trans }}</h3>
            <p class="text-muted">{{ 'home.features.favorites.desc'|trans }}</p>
        </div>
    </div>
</div>
    <div style="margin-top: 5rem; padding: 2rem; background: rgba(16, 185, 129, 0.1); border-radius: 1rem; border: 1px solid var(--success); text-align: center;">
        <span style="background: var(--success); color: white; padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">{{ 'eco.badge'|trans }}</span>
        <h2 style="margin-top: 1rem; color: #d1fae5;">{{ 'eco.title'|trans }}</h2>
        <p style="color: #6ee7b7; max-width: 600px; margin: 0 auto;">
            {{ 'eco.desc'|trans }}
        </p>
        <a href="{{ path('app_eco') }}" style="display: inline-block; margin-top: 1rem; color: #d1fae5; text-decoration: underline;">{{ 'eco.learn_more'|trans }}</a>
    </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "GiftList",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR"
  },
  "description": "Application de liste de cadeaux collaborative et éco-conçue.",
  "author": {
    "@type": "Organization",
    "name": "e-responsable",
    "url": "https://e-responsable.com"
  }
}
</script>
{% endblock %}
