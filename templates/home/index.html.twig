{% extends 'base.html.twig' %}

{% block title %}Welcome to GiftList{% endblock %}

{% block body %}
<div style="text-align: center; margin-top: 4rem;">
    <h1 style="font-size: 3rem; margin-bottom: 1rem;">Create Your Perfect Wishlist</h1>
    <p class="text-muted" style="font-size: 1.25rem; max-width: 600px; margin: 0 auto 2rem;">
        Add gifts from any website, organize your list, and share it with friends and family. Never get a wrong gift again.
    </p>
    
    <div class="flex" style="justify-content: center; gap: 1rem;">
        <a href="{{ path('app_register') }}" class="btn btn-primary" style="font-size: 1.2rem; padding: 0.75rem 2rem;">Get Started</a>
        <a href="{{ path('app_login') }}" class="btn btn-outline" style="font-size: 1.2rem; padding: 0.75rem 2rem;">Login</a>
    </div>
    
    <div class="grid" style="margin-top: 4rem; text-align: left;">
        <div class="card">
            <h3>📝 Create Lists</h3>
            <p class="text-muted">Add items manually or paste a link to auto-fill details.</p>
        </div>
        <div class="card">
            <h3>🤝 Share & Connect</h3>
            <p class="text-muted">Connect with friends and view their wishlists instantly.</p>
        </div>
        <div class="card">
            <h3>⭐ Favorites</h3>
            <p class="text-muted">Mark items you plan to buy or love as favorites.</p>
        </div>
    </div>
</div>
{% endblock %}
