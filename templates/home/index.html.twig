{% extends 'base.html.twig' %}

{% block title %}Welcome to GiftList{% endblock %}

{% block body %}
<div style="text-align: center; margin-top: 4rem;">
    <h1 style="font-size: 3rem; margin-bottom: 1rem;">{{ 'home.subtitle'|trans }}</h1>
    <p class="text-muted" style="font-size: 1.25rem; max-width: 600px; margin: 0 auto 2rem;">
        {{ 'home.description'|trans }}
    </p>
    
    <div class="flex" style="justify-content: center; gap: 1rem;">
        <a href="{{ path('app_register') }}" class="btn btn-primary" style="font-size: 1.2rem; padding: 0.75rem 2rem;">{{ 'home.get_started'|trans }}</a>
        <a href="{{ path('app_login') }}" class="btn btn-outline" style="font-size: 1.2rem; padding: 0.75rem 2rem;">{{ 'nav.login'|trans }}</a>
    </div>
    
    <div class="grid" style="margin-top: 4rem; text-align: left;">
        <div class="card">
            <h3>{{ 'home.features.lists.title'|trans }}</h3>
            <p class="text-muted">{{ 'home.features.lists.desc'|trans }}</p>
        </div>
        <div class="card">
            <h3>{{ 'home.features.share.title'|trans }}</h3>
            <p class="text-muted">{{ 'home.features.share.desc'|trans }}</p>
        </div>
        <div class="card">
            <h3>{{ 'home.features.favorites.title'|trans }}</h3>
            <p class="text-muted">{{ 'home.features.favorites.desc'|trans }}</p>
        </div>
    </div>
</div>
{% endblock %}
