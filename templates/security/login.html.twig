{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
<div style="max-width: 400px; margin: 4rem auto;">
    <div class="card">
        <h1 style="text-align: center; margin-bottom: 2rem;">{{ 'auth.login.welcome'|trans }}</h1>
        
        <form method="post">
            {% if error %}
                <div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <label for="username">{{ 'auth.login.email'|trans }}</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>

            <label for="password">{{ 'auth.login.password'|trans }}</label>
            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            {# Honeypot #}
            <div style="display:none;">
                <label>Ne pas remplir / Do not fill</label>
                <input type="text" name="_hp_login" tabindex="-1" autocomplete="off">
            </div>

            <button class="btn btn-primary" type="submit" style="width: 100%; margin-top: 1rem;">
                {{ 'auth.login.btn'|trans }}
            </button>
            
            <p style="text-align: center; margin-top: 1rem; font-size: 0.9rem;">
                {{ 'auth.login.no_account'|trans }} <a href="{{ path('app_register') }}">{{ 'auth.login.signup_link'|trans }}</a>
            </p>
        </form>
    </div>
</div>
{% endblock %}
